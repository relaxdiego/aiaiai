model_list:
  # Claude Code model IDs mapped to GitHub Copilot models. Prices per token from
  # https://docs.github.com/en/copilot/reference/copilot-billing/models-and-pricing
  # No wildcard route: an unpriced model would bill at 0 and escape max_budget.
  # LiteLLM signs in with the tokens in GITHUB_COPILOT_TOKEN_DIR (see
  # process-compose.yaml), written by `make copilot-login`.
  # Fable and Opus are served only at 1M context. Claude Code's "(1M context)"
  # picker entry still sends the bare model name on the wire (the bracketed ID
  # is a UI label only), so the model_name here stays bare. `extra_headers`
  # pins the beta that unlocks the window on every request to it, so the
  # client gets 1M whether or not it sends the header itself: LiteLLM drops a
  # client's own anthropic-beta unless forward_client_headers_to_llm_api is on,
  # and that would also forward every x-* header and Authorization.
  - model_name: claude-fable-5-1
    litellm_params:
      model: github_copilot/claude-fable-5.1
      extra_headers:
        anthropic-beta: context-1m-2025-08-07
      input_cost_per_token: 1.0e-05
      output_cost_per_token: 5.0e-05
      cache_read_input_token_cost: 2.5e-07
      cache_creation_input_token_cost: 1.25e-05

  - model_name: claude-opus-5-5
    litellm_params:
      model: github_copilot/claude-opus-5.5
      extra_headers:
        anthropic-beta: context-1m-2025-08-07
      input_cost_per_token: 4.0e-06
      output_cost_per_token: 2.0e-05
      cache_read_input_token_cost: 2.0e-07
      cache_creation_input_token_cost: 5.0e-06

  - model_name: claude-sonnet-5
    litellm_params:
      model: github_copilot/claude-sonnet-5
      input_cost_per_token: 2.0e-06
      output_cost_per_token: 1.0e-05
      cache_read_input_token_cost: 2.0e-07
      cache_creation_input_token_cost: 2.5e-06

  - model_name: claude-haiku-4-5-20251001
    litellm_params:
      model: github_copilot/claude-haiku-4.5
      input_cost_per_token: 1.0e-06
      output_cost_per_token: 5.0e-06
      cache_read_input_token_cost: 1.0e-07
      cache_creation_input_token_cost: 1.25e-06

  # Non-Claude models. Grok, Sol, and Astra are priced per context tier
  # upstream; these are the standard tiers (Grok <=200K, Sol and Astra <=272K).
  # A request above the threshold costs more than recorded here.
  - model_name: grok-4.6
    litellm_params:
      model: github_copilot/grok-4.6
      input_cost_per_token: 2.0e-06
      output_cost_per_token: 6.0e-06
      cache_read_input_token_cost: 5.0e-07
      # xAI publishes no cache-write price and Copilot does not bill one.
      cache_creation_input_token_cost: 0.0

  - model_name: grok-4.7
    litellm_params:
      model: github_copilot/grok-4.7
      input_cost_per_token: 2.0e-06
      output_cost_per_token: 6.0e-06
      cache_read_input_token_cost: 5.0e-07
      # xAI publishes no cache-write price and Copilot does not bill one.
      cache_creation_input_token_cost: 0.0

  - model_name: gpt-5.6-sol
    litellm_params:
      model: github_copilot/gpt-5.6-sol
      input_cost_per_token: 4.0e-06
      output_cost_per_token: 2.0e-05
      cache_read_input_token_cost: 4.0e-07
      cache_creation_input_token_cost: 5.0e-06

  # OpenAI's frontier model. Also tiered; this is the standard tier (<=272K).
  - model_name: gpt-6-astra
    litellm_params:
      model: github_copilot/gpt-6-astra
      input_cost_per_token: 1.0e-05
      output_cost_per_token: 5.0e-05
      cache_read_input_token_cost: 1.0e-06
      cache_creation_input_token_cost: 1.25e-05

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
  # Set by process-compose.yaml to the bundled Postgres.
  database_url: os.environ/DATABASE_URL
  store_model_in_db: true
  store_prompts_in_spend_logs: true

litellm_settings:
  # Rendered from LITELLM_MAX_BUDGET in .envrc.local by `make setup`. A literal,
  # not os.environ/: LiteLLM < v1.90.0 did not coerce an env-sourced max_budget
  # to a number. The pinned version does; see AGENTS.md.
  max_budget: __LITELLM_MAX_BUDGET__
  budget_duration: 30d
  maximum_spend_logs_retention_period: "7d"     # delete logs older than 7 days
  maximum_spend_logs_retention_interval: "1d"   # run the cleanup job daily

  # Copilot has no web search. Claude Code sends web_search as a standalone
  # request, which LiteLLM answers from SearXNG without calling Copilot.
  callbacks: ["websearch_interception"]
  websearch_interception_params:
    enabled_providers:
      - github_copilot
    search_tool_name: local-search

# SearXNG runs locally under process-compose. The searxng provider finds it
# through SEARXNG_API_BASE, which process-compose.yaml sets. Agents can also call
# it directly at POST /v1/search/local-search.
search_tools:
  - search_tool_name: local-search
    litellm_params:
      search_provider: searxng
