# Load devbox-managed tools into PATH
if command -v devbox >/dev/null 2>&1; then
  eval "$(devbox shellenv)"
else
  printf '%s\n' \
    "aiaiai: devbox is not installed; see README.md or https://www.jetify.com/devbox/docs/installing_devbox/" \
    >&2
fi

# Load machine-local secrets and config (git-ignored)
source_env_if_exists .envrc.local

# Derive client env vars from the single gateway source of truth
# export ANTHROPIC_BASE_URL="${GATEWAY_BASE_URL:-http://127.0.0.1:4000}"
# export ANTHROPIC_AUTH_TOKEN="${LITELLM_MASTER_KEY:-}"
