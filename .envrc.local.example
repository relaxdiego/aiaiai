# Written by 'make setup'. Re-run it to change any value; lines you add yourself
# are kept. Never commit this file.

# Address LiteLLM listens on. Use the host side of your coding-agent VM network.
# 0.0.0.0 exposes the gateway on every network this machine joins.
export LITELLM_HOST=127.0.0.1

# Admin key for the gateway. Generated once. Give agents 'make new-key' keys instead.
export LITELLM_MASTER_KEY=sk-CHANGEME

# Spend cap in USD per 30 days, rendered into litellm/config.yaml.
export LITELLM_MAX_BUDGET=120

# SearXNG secret_key. Generated once.
export SEARXNG_SECRET=CHANGEME

# Password for the bundled Postgres in data/postgres. Generated once; the
# database is created with it, so changing it here alone breaks LiteLLM.
export POSTGRES_PASSWORD=CHANGEME
