# Admin key for the LiteLLM gateway. Auto-generated by 'make setup'.
export LITELLM_MASTER_KEY=sk-CHANGEME

# PostgreSQL database for LiteLLM UI and user management
export DATABASE_URL=postgresql://postgres@127.0.0.1/litellm

# LiteLLM spend cap in USD per budget_duration. 'make setup' renders this into
# the generated litellm/config.yaml as a literal value. To change it, edit here
# and re-run 'make setup' (no git commit needed).
export LITELLM_MAX_BUDGET=120

# SearXNG secret_key for the local web-search backend. Auto-generated by
# 'make setup'. Overrides server.secret_key in searxng/settings.yml.
export SEARXNG_SECRET=CHANGEME

# Base URL the LiteLLM websearch_interception callback uses to reach SearXNG.
# REQUIRED: the callback reads this env var directly and does NOT use the
# api_base in litellm/config.yaml's search_tools block. Must match
# searxng/settings.yml's bind_address:port (default localhost loopback).
export SEARXNG_API_BASE=http://127.0.0.1:8888

# AWS Bedrock credentials referenced in litellm/config.yaml
export AWS_BEARER_TOKEN_BEDROCK=CHANGEME
export AWS_REGION=us-east-1
